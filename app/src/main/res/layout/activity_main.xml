<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="beforeDescendants"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="DistAI"
                android:src="@drawable/ic_launcher" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:text="DistAI"
                android:textColor="#1B2A41"
                android:textSize="26sp"
                android:textStyle="bold" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <TextView
                android:id="@+id/flagIt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="🇮🇹"
                android:textSize="26sp" />
            <TextView
                android:id="@+id/flagEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="🇬🇧"
                android:textSize="26sp" />
        </LinearLayout>

        <!-- STATUS: at a glance if the cluster is connected, the model loaded and this phone at work -->
        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Card"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/pulse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingEnd="8dp"
                    android:text="●"
                    android:textColor="#9E9E9E"
                    android:textSize="18sp" />
                <TextView android:id="@+id/statusTitle" style="@style/Title" android:text="CLUSTER STATUS / 集群状态" />
            </LinearLayout>
            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textSize="14sp" />
        </LinearLayout>

        <com.distai.app.ClusterView
            android:id="@+id/clusterView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/info"
            style="@style/Card"
            android:textSize="13sp" />

        <!-- WORKER -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/Title" android:text="THIS PHONE AS WORKER / 此手机作为工作节点" />
            <TextView
                style="@style/Hint"
                android:text="Provides CPU and RAM for compute. Enable on all network phones. / 提供CPU和RAM用于计算。请在局域网内所有手机上开启。" />
            <Switch
                android:id="@+id/workerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:text="Worker active / 开启工作节点" />
            <CheckBox
                android:id="@+id/autoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-start worker on app launch / 应用启动时自动运行" />
            <CheckBox
                android:id="@+id/keepScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keep screen on (prevents standby) / 保持屏幕常亮 (防休眠)" />
            <Button
                android:id="@+id/battery"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disable battery optimization / 关闭电池优化" />
            <Button
                android:id="@+id/freeRam"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free RAM (closes background apps) / 释放内存 (结束后台应用)" />
        </LinearLayout>

        <!-- COORDINATOR -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <TextView style="@style/Title" android:text="COORDINATOR / 协调器" />
            <TextView
                style="@style/Hint"
                android:text="Selects nodes, loads model, and distributes layers across phones. / 选择节点，加载模型并将层分配到各手机。" />

            <TextView
                android:id="@+id/nodesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Nodes found: 0 / 发现节点: 0"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/nodesLegend"
                style="@style/Hint" />
            <LinearLayout
                android:id="@+id/nodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/manualIp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Manual IP (e.g. 192.168.1.23) / 手动输入IP"
                    android:inputType="text"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/addIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add / 添加" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Model / 模型"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <EditText
                android:id="@+id/customUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="...or URL to a .gguf file / ...或输入 .gguf 链接"
                android:inputType="textUri"
                android:textSize="14sp" />
            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <Button
                android:id="@+id/download"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Download model / 下载模型" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Context (tokens): / 上下文: " />
                <EditText
                    android:id="@+id/ctx"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:text="4096" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <RadioButton
                    android:id="@+id/modeSplit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Split: large model split across phones / Split模式: 大模型切分至多台手机" />
                <RadioButton
                    android:id="@+id/modeReplica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Replica: model copied to each phone (multi-user) / Replica模式: 模型复制到每台手机 (多用户)" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/moeFast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast MoE: 6 of 8 experts (Qwen3 MoE: +12-25% tok/s, same quality) / 快速MoE: 选8个中的6个专家 (提速12-25%，质量相同)" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Coordinator: / 协调器: " />
                <Spinner
                    android:id="@+id/coordChoice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
            <Button
                android:id="@+id/benchBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benchmark node speed / 节点测速" />

            <Button
                android:id="@+id/coordBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#2E7D32"
                android:text="Start Distributed LLM / 启动分布式大模型"
                android:textColor="#FFFFFF" />
            <TextView
                android:id="@+id/apiStatus"
                style="@style/Hint"
                android:textIsSelectable="true" />
            <Button
                android:id="@+id/chatBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="Open chat / 打开对话" />
        </LinearLayout>

        <!-- LOG -->
        <LinearLayout style="@style/Card" android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    style="@style/Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Log / 日志" />
                <Button
                    android:id="@+id/clearLog"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Clear / 清空" />
            </LinearLayout>
            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#111827"
                android:fontFamily="monospace"
                android:maxLines="40"
                android:padding="8dp"
                android:textColor="#D1FAE5"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
